          "type": "code",
          "lang": "sql",
          "wide": true,
          "code": "create table accounts (\n  user_id serial PRIMARY KEY,\n  username VARCHAR(50) UNIQUE NOT NULL,\n  password VARCHAR(50) NOT NULL,\n  email VARCHAR(255) UNIQUE NOT NULL,\n  created_on TIMESTAMP NOT NULL,\n  last_login TIMESTAMP\n);"
        },
        { "type": "p", "text": "Удалить таблицу: `drop table accounts;`" },

        {
          "type": "h2",
          "text": "Подключение в проектах",
          "id": "Connecting-to-a-database-in-projects"
        },
        {
          "type": "p",
          "text": "PostgreSQL по умолчанию работает на порту 5432. Подключение выполняется по IP и порту (например, localhost:5432)."
        },
        {
          "type": "p",
          "text": "Для хранения параметров подключения используйте ENV-файлы (IP, порт, логин, пароль)."
        },
        {
          "type": "ul",
          "items": [
            "Создать пользователя: `CREATE ROLE MyNewUserName WITH LOGIN PASSWORD 'MyNewUserPassword';`",
            "Разрешить создание БД: `ALTER ROLE MyNewUserName CREATEDB;`",
            "Вход новым пользователем: `psql postgres -U MyNewUserName`"
