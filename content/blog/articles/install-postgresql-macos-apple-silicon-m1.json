          ]
        },

        { "type": "h3", "text": "Autorización", "id": "Authorization" },
        {
          "type": "ul",
          "items": [
            "Usuario por defecto: `psql postgres`",
            "Usuario específico: `psql postgres -U [nombre_usuario]`",
            "Salir: `\\q`"
          ]
        },

        { "type": "h3", "text": "Bases de datos", "id": "Databases" },
        {
          "type": "ul",
          "items": [
            "Listar BDs: `\\l`",
            "Crear: `create database [nombre];`",
            "Eliminar: `drop database [nombre];`",
            "Renombrar: `alter database [antiguo] rename to [nuevo];`"
          ]
        },
        { "type": "p", "text": "Importar base de datos:" },
        {
          "type": "ul",
          "items": [
            "`psql -h [host] -d [db] -U [usuario] -f ~/ruta/a/archivo.sql`",
            "`psql [db] < ~/ruta/a/archivo.sql`"
          ]
        },
        {
          "type": "p",
          "text": "Exportar BD: `pg_dump -U [usuario] -h [host] [db] >> export_file.sql`"
        },

        { "type": "h3", "text": "Usuarios", "id": "Users" },
        {
          "type": "ul",
          "items": [
            "Crear usuario con contraseña: `create role [nombre] with login password 'pass';`",
            "Con contraseña cifrada: `create role [nombre] with login encrypted password 'pass';`",
            "Sin contraseña: `create role [nombre] with login;`",
            "Eliminar usuario: `drop user [nombre];`",
            "Renombrar usuario: `alter user [antiguo] rename to [nuevo];`",
            "Cambiar contraseña: `alter user [nombre] with password 'new_pass';`"
          ]
        },

        { "type": "h3", "text": "Tablas", "id": "Tables" },
        { "type": "p", "text": "Ejemplo de creación de tabla:" },
        {
          "type": "code",
          "lang": "sql",
          "wide": true,
          "code": "create table accounts (\n  user_id serial PRIMARY KEY,\n  username VARCHAR(50) UNIQUE NOT NULL,\n  password VARCHAR(50) NOT NULL,\n  email VARCHAR(255) UNIQUE NOT NULL,\n  created_on TIMESTAMP NOT NULL,\n  last_login TIMESTAMP\n);"
        },
        { "type": "p", "text": "Eliminar tabla: `drop table accounts;`" },

        {
          "type": "h2",
          "text": "Conexión a bases de datos en proyectos",
          "id": "Connecting-to-a-database-in-projects"
        },
        {
          "type": "p",
          "text": "PostgreSQL se ejecuta en el puerto 5432 por defecto. Conéctate usando IP y puerto (por ejemplo, localhost:5432)."
        },
        {
          "type": "p",
          "text": "Usa archivos ENV para almacenar detalles de conexión (IP, puerto, usuario, contraseña)."
        },
        {
          "type": "ul",
          "items": [
            "Crear usuario: `CREATE ROLE MyNewUserName WITH LOGIN PASSWORD 'MyNewUserPassword';`",
            "Conceder creación de BD: `ALTER ROLE MyNewUserName CREATEDB;`",
            "Iniciar sesión como nuevo usuario: `psql postgres -U MyNewUserName`"
          ]
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Recordatorio",
          "blocks": [
            {
              "type": "p",
              "text": "Reemplaza MyNewUserName/MyNewUserPassword con tus credenciales."
            }
          ]
        }
      ]
    },

    "de": {
      "title": "PostgreSQL auf macOS installieren (Apple Silicon m1/m2)",
      "anonce": "Wie man PostgreSQL auf macOS (einschließlich Apple Silicon M1/M2) installiert und mit Anwendungen verbindet.",
      "content": [
        { "type": "h2", "text": "Einführung", "id": "Introduction" },
        {
          "type": "p",
          "text": "Bei der Entwicklung von Anwendungen ist es oft notwendig, Daten in Datenbanken zu speichern und zu verwalten. Dieser Artikel zeigt, wie man PostgreSQL auf macOS installiert und mit Anwendungen verbindet."
        },
        {
          "type": "p",
          "text": "Wir behandeln Installationsmethoden, Nutzung des Terminals, Verbindung aus Anwendungen und grundlegende PostgreSQL-Befehle."
        },

        { "type": "h2", "text": "Installation", "id": "Installation" },
        {
          "type": "p",
          "text": "PostgreSQL kann auf zwei Arten installiert werden:"
        },
        {
          "type": "ul",
          "items": [
            "Über den Installer von der offiziellen Website",
            "Mit dem Paketmanager Homebrew (empfohlen)"
          ]
        },
        {
          "type": "p",
          "text": "Beide Methoden ermöglichen die vollständige Installation von PostgreSQL auf dem System."
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Empfohlene Methode",
          "blocks": [
            {
              "type": "p",
              "text": "Die am häufigsten verwendete und empfohlene Methode zur Installation von PostgreSQL ist über Homebrew."
            }
          ]
        },

        {
          "type": "h3",
          "text": "Über den Installer",
          "id": "Through-the-installer"
        },
        {
          "type": "p",
          "html": "Gehe zur <a href=\"https://www.postgresql.org/ftp/source/\" target=\"_blank\">offiziellen PostgreSQL-Website</a> und lade die gewünschte Version herunter."
        },
        {
          "type": "ul",
          "items": [
            "Wähle die benötigte Version (z. B. v14.2) und öffne das Verzeichnis",
            "Lade <strong>postgresql-[version].tar.gz</strong> herunter",
            "Entpacke und öffne den Ordner",
            "Prüfe die INSTALL-Datei für Schritt-für-Schritt-Anweisungen",
            "Folge den Anweisungen im Terminal zur Installation"
          ]
        },

        { "type": "h3", "text": "Über Homebrew", "id": "Through-Homebrew" },
        {
          "type": "p",
          "text": "Vor der Installation Homebrew prüfen und aktualisieren:"
        },
        {
          "type": "ul",
          "items": [
            "Update: `brew update`",
            "Upgrade: `brew upgrade`",
            "Fehler prüfen: `brew doctor`"
          ]
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Mehr Informationen",
          "blocks": [
            {
              "type": "p",
              "html": "Siehe Anleitung: <a href=\"https://amaryfilo.com/blog/how-install-homebrew\" target=\"_blank\">Wie man Homebrew installiert</a>."
            }
          ]
        },
        {
          "type": "p",
          "text": "Schritte zur Installation von PostgreSQL mit Homebrew:"
        },
        {
          "type": "ul",
          "items": [
            "`brew install postgresql`",
            "`brew services start postgresql` (Dienst starten)",
            "`brew services stop postgresql` (Dienst stoppen)",
            "`brew services list` (Dienststatus anzeigen)",
            "Anmelden: `psql postgres`",
            "Benutzer auflisten: `\\du`",
            "Beenden: `\\q`"
          ]
        },

        { "type": "h3", "text": "Extras", "id": "Extras" },
        {
          "type": "ul",
          "items": [
            "Manueller Start: `/opt/homebrew/opt/postgresql/bin/postgres -D /opt/homebrew/var/postgres`",
            "Start/Stop mit pg_ctl: `pg_ctl -D /opt/homebrew/var/postgres start|stop`"
          ]
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Deinstallation",
          "blocks": [
            {
              "type": "p",
              "text": "PostgreSQL entfernen mit: `brew uninstall postgresql`, dann `brew cleanup` und `brew doctor`."
            }
          ]
        },

        { "type": "h2", "text": "Fehler", "id": "Errors" },
        {
          "type": "p",
          "text": "Häufige Fehler, die während der Einrichtung auftreten können."
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Tipp",
          "blocks": [
            {
              "type": "p",
              "text": "Oft hilft es, das Gerät oder das Terminal neu zu starten."
            }
          ]
        },
        {
          "type": "h3",
          "text": "Bootstrap failed: 5: Ein-/Ausgabe-Fehler",
          "id": "Bootstrap-failed-5"
        },
        {
          "type": "p",
          "text": "Erscheint nach `brew services start postgresql`."
        },
        {
          "type": "p",
          "text": "Lösung: `launchctl remove homebrew.mxcl.postgresql` ausführen, dann `brew services start postgresql`."
        },

        { "type": "h2", "text": "Befehle", "id": "Commands" },
        {
          "type": "note",
          "kind": "info",
          "title": "Autorisierung",
          "blocks": [
            {
              "type": "p",
              "text": "Befehle werden in `psql` als autorisierter Benutzer eingegeben."
            }
          ]
        },

        { "type": "h3", "text": "Autorisierung", "id": "Authorization" },
        {
          "type": "ul",
          "items": [
            "Standardbenutzer: `psql postgres`",
            "Bestimmter Benutzer: `psql postgres -U [benutzername]`",
            "Beenden: `\\q`"
          ]
        },

        { "type": "h3", "text": "Datenbanken", "id": "Databases" },
        {
          "type": "ul",
          "items": [
            "Datenbanken auflisten: `\\l`",
            "Erstellen: `create database [name];`",
            "Löschen: `drop database [name];`",
            "Umbenennen: `alter database [alt] rename to [neu];`"
          ]
        },
        { "type": "p", "text": "Datenbank importieren:" },
        {
          "type": "ul",
          "items": [
            "`psql -h [host] -d [db] -U [benutzer] -f ~/pfad/zu/datei.sql`",
            "`psql [db] < ~/pfad/zu/datei.sql`"
          ]
        },
        {
          "type": "p",
          "text": "Datenbank exportieren: `pg_dump -U [benutzer] -h [host] [db] >> export_file.sql`"
        },

        { "type": "h3", "text": "Benutzer", "id": "Users" },
        {
          "type": "ul",
          "items": [
            "Benutzer mit Passwort erstellen: `create role [name] with login password 'pass';`",
            "Mit verschlüsseltem Passwort: `create role [name] with login encrypted password 'pass';`",
            "Ohne Passwort: `create role [name] with login;`",
            "Benutzer löschen: `drop user [name];`",
            "Benutzer umbenennen: `alter user [alt] rename to [neu];`",
            "Passwort ändern: `alter user [name] with password 'new_pass';`"
          ]
        },

        { "type": "h3", "text": "Tabellen", "id": "Tables" },
        { "type": "p", "text": "Beispiel für das Erstellen einer Tabelle:" },
        {
          "type": "code",
          "lang": "sql",
          "wide": true,
          "code": "create table accounts (\n  user_id serial PRIMARY KEY,\n  username VARCHAR(50) UNIQUE NOT NULL,\n  password VARCHAR(50) NOT NULL,\n  email VARCHAR(255) UNIQUE NOT NULL,\n  created_on TIMESTAMP NOT NULL,\n  last_login TIMESTAMP\n);"
        },
        { "type": "p", "text": "Tabelle löschen: `drop table accounts;`" },

        {
          "type": "h2",
          "text": "Verbindung zu Datenbanken in Projekten",
          "id": "Connecting-to-a-database-in-projects"
        },
        {
          "type": "p",
          "text": "PostgreSQL läuft standardmäßig auf Port 5432. Verbindung über IP und Port herstellen (z. B. localhost:5432)."
        },
        {
          "type": "p",
          "text": "Verwende ENV-Dateien, um Verbindungsdetails (IP, Port, Benutzername, Passwort) zu speichern."
        },
        {
          "type": "ul",
          "items": [
            "Benutzer erstellen: `CREATE ROLE MyNewUserName WITH LOGIN PASSWORD 'MyNewUserPassword';`",
            "DB-Erstellung erlauben: `ALTER ROLE MyNewUserName CREATEDB;`",
            "Als neuer Benutzer anmelden: `psql postgres -U MyNewUserName`"
          ]
        },
        {
          "type": "note",
          "kind": "info",
          "title": "Erinnerung",
          "blocks": [
            {
              "type": "p",
              "text": "Ersetze MyNewUserName/MyNewUserPassword durch deine Daten."
            }
          ]
        }
      ]
    }
  }
}
