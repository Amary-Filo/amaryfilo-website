          "type": "ul",
          "items": [
            "Пользователь по умолчанию: `psql postgres`",
            "Определённый пользователь: `psql postgres -U [user_name]`",
            "Выход: `\\q`"
          ]
        },

        { "type": "h3", "text": "Базы данных", "id": "Databases" },
        {
          "type": "ul",
          "items": [
            "Список баз: `\\l`",
            "Создать: `create database [name];`",
            "Удалить: `drop database [name];`",
            "Переименовать: `alter database [old] rename to [new];`"
          ]
        },
        { "type": "p", "text": "Импорт базы данных:" },
        {
          "type": "ul",
          "items": [
            "`psql -h [host] -d [db] -U [user] -f ~/path/to/file.sql`",
            "`psql [db] < ~/path/to/file.sql`"
          ]
        },
        {
          "type": "p",
          "text": "Экспорт базы: `pg_dump -U [user] -h [host] [db] >> export_file.sql`"
        },

        { "type": "h3", "text": "Пользователи", "id": "Users" },
        {
          "type": "ul",
          "items": [
            "Создать пользователя с паролем: `create role [name] with login password 'pass';`",
            "С зашифрованным паролем: `create role [name] with login encrypted password 'pass';`",
            "Без пароля: `create role [name] with login;`",
            "Удалить: `drop user [name];`",
            "Переименовать: `alter user [old] rename to [new];`",
            "Сменить пароль: `alter user [name] with password 'new_pass';`"
          ]
        },

        { "type": "h3", "text": "Таблицы", "id": "Tables" },
        { "type": "p", "text": "Пример создания таблицы:" },
