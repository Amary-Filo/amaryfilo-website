  "base": {
    "anonce": "How standalone components simplify modules and bootstrapping.",
    "content": [
      {
        "type": "p",
        "text": "Standalone components remove the need for NgModules in many cases and streamline setup."
      },
      {
        "type": "h2",
        "text": "What Is a Standalone Component?",
        "id": "what-is-standalone"
      },
      {
        "type": "p",
        "text": "It declares its own imports and can be bootstrapped directly."
      },
      {
        "type": "code",
        "lang": "typescript",
        "code": "bootstrapApplication(AppComponent, { providers: [] });"
      },
      {
        "type": "note",
        "kind": "info",
        "title": "Tip",
        "blocks": [
          {
            "type": "p",
            "text": "Use 'imports' in @Component to bring pipes and directives."
          }
        ]
      },
      { "type": "h3", "text": "Routing With Standalone", "id": "routing" },
      {
        "type": "p",
        "text": "Use provideRouter with lazy 'loadComponent' instead of modules."
      },
      { "type": "h2", "text": "When to Use", "id": "when-to-use" },
      {
        "type": "ul",
        "items": ["New apps", "Feature islands", "Library examples"]
      }
    ]
  },
