      "text": "`satisfies` helps check that objects conform to a type without widening."
    },
    {
      "type": "h2",
      "text": "Why `satisfies`?",
      "id": "why"
    },
    {
      "type": "code",
      "lang": "typescript",
      "code": "const cfg = {\n  lang: 'en',\n  items: ['a','b']\n} as const satisfies { lang: 'en'|'ru'; items: readonly string[] };"
    },
    {
      "type": "h2",
      "text": "Avoid `as` casts",
      "id": "avoid-as"
